# Copy this file to BOTH server/.env and livekit_agent/.env, then fill it in.
# Never commit a filled-in copy — .env is gitignored.

# ---- LiveKit (both server/ and livekit_agent/ need these) ----
LIVEKIT_URL=            # wss://<subdomain>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Agent: video avatar ----
# STT (Deepgram Flux), LLM (Gemini 2.5 Flash) and TTS (Cartesia Sonic-3) run
# through LiveKit's inference gateway and are billed via the LiveKit project
# above — they need no separate provider keys.
LIVEAVATAR_API_KEY=

# Only needed if you swap the commented-out Tavus block into app.py
# in place of the LiveAvatar session.
# TAVUS_API_KEY=
# TAVUS_REPLICA_ID=
# TAVUS_PERSONA_ID=

# ---- Server ----
GHL_INBOUND_WEBHOOK_URL=    # https://services.leadconnectorhq.com/hooks/.../webhook-trigger/...
DEMO_PAGE_URL=https://bizapp247.com/demo
ALLOWED_ORIGINS=https://bizapp247.com,https://www.bizapp247.com
